{
  "name": "taskingen",
  "displayName": "Taskingen",
  "description": "Run npm, Deno, and shell scripts from the Explorer sidebar.",
  "version": "0.1.7",
  "publisher": "cemcakirlar",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cemcakirlar/taskingen.git"
  },
  "bugs": {
    "url": "https://github.com/cemcakirlar/taskingen/issues"
  },
  "homepage": "https://github.com/cemcakirlar/taskingen#readme",
  "keywords": [
    "scripts",
    "npm",
    "deno",
    "shell",
    "tasks",
    "terminal",
    "explorer"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "scripts": {
    "install:deps": "npm install",
    "compile": "tsc -p ./",
    "compile:test": "tsc -p tsconfig.test.json",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "vsce publish",
    "publish:ovsx": "ovsx publish",
    "test": "npm run test:unit",
    "test:unit": "npm run compile:test && node --require ./test/helpers/register-vscode-mock.cjs --test 'out-test/test/unit/**/*.test.js'",
    "test:integration": "npm run compile:test && node --require ./test/helpers/register-vscode-mock.cjs --test 'out-test/test/integration/**/*.test.js'",
    "test:e2e": "npm run compile:test && node --require ./test/helpers/register-vscode-mock.cjs --test 'out-test/test/e2e/**/*.test.js'"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.125.0",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.0.2",
    "typescript": "^5.8.0"
  },
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "taskingen.scripts",
          "name": "Taskingen",
          "contextualTitle": "Taskingen"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "taskingen.scripts",
        "contents": "Open a folder to discover npm, Deno, and shell scripts.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      }
    ],
    "commands": [
      {
        "command": "taskingen.open",
        "title": "Taskingen: Open Script Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "taskingen.run",
        "title": "Taskingen: Run Script",
        "icon": "$(play)"
      },
      {
        "command": "taskingen.stop",
        "title": "Taskingen: Stop Script",
        "icon": "$(debug-stop)"
      },
      {
        "command": "taskingen.refresh",
        "title": "Taskingen: Refresh Scripts",
        "icon": "$(refresh)"
      },
      {
        "command": "taskingen.addFavorite",
        "title": "Taskingen: Add to Favorites",
        "icon": "$(star-empty)"
      },
      {
        "command": "taskingen.removeFavorite",
        "title": "Taskingen: Remove from Favorites",
        "icon": "$(star-full)"
      },
      {
        "command": "taskingen.clearFavorites",
        "title": "Taskingen: Clear Favorites",
        "icon": "$(clear-all)"
      },
      {
        "command": "taskingen.clearHistory",
        "title": "Taskingen: Clear Task History",
        "icon": "$(clear-all)"
      },
      {
        "command": "taskingen.removeFromHistory",
        "title": "Taskingen: Remove from History",
        "icon": "$(close)"
      },
      {
        "command": "taskingen.activateScript",
        "title": "Taskingen: Activate Script"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "taskingen.refresh",
          "when": "view == taskingen.scripts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "taskingen.open",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)Script(History)?(Favorited)?(Running)?$/",
          "group": "inline@1"
        },
        {
          "command": "taskingen.run",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)Script(History)?(Favorited)?$/",
          "group": "inline@2"
        },
        {
          "command": "taskingen.stop",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)Script(History)?(Favorited)?Running$/",
          "group": "inline@2"
        },
        {
          "command": "taskingen.open",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)Script(History)?(Favorited)?(Running)?$/",
          "group": "actions@1"
        },
        {
          "command": "taskingen.run",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)Script(History)?(Favorited)?$/",
          "group": "actions@2"
        },
        {
          "command": "taskingen.stop",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)Script(History)?(Favorited)?Running$/",
          "group": "actions@3"
        },
        {
          "command": "taskingen.addFavorite",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)Script(History)?(Running)?$/",
          "group": "inline@3"
        },
        {
          "command": "taskingen.removeFavorite",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)Script(History)?Favorited(Running)?$/",
          "group": "inline@3"
        },
        {
          "command": "taskingen.removeFromHistory",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)ScriptHistory(Favorited)?(Running)?$/",
          "group": "inline@4"
        },
        {
          "command": "taskingen.addFavorite",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)Script(History)?(Running)?$/",
          "group": "favorites@1"
        },
        {
          "command": "taskingen.removeFavorite",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)Script(History)?Favorited(Running)?$/",
          "group": "favorites@1"
        },
        {
          "command": "taskingen.removeFromHistory",
          "when": "view == taskingen.scripts && viewItem =~ /^(npm|deno|shell)ScriptHistory(Favorited)?(Running)?$/",
          "group": "history@1"
        },
        {
          "command": "taskingen.clearFavorites",
          "when": "view == taskingen.scripts && viewItem == taskFavorites",
          "group": "inline@1"
        },
        {
          "command": "taskingen.clearHistory",
          "when": "view == taskingen.scripts && viewItem == taskHistory",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Taskingen",
      "properties": {
        "taskingen.discovery.exclude": {
          "type": "array",
          "order": 10,
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Gitignore-style patterns for folders and paths to skip when discovering npm, Deno, and shell scripts. Examples: legacy, legacy/**, packages/generated/**, /tools. Lines starting with # are ignored. A leading / limits the pattern to the workspace root."
        },
        "taskingen.tree.hideEmptyScriptRoots": {
          "type": "boolean",
          "order": 20,
          "default": true,
          "description": "Hide npm Scripts, Deno Tasks, and Shell Scripts root groups when no scripts of that type were discovered in the workspace."
        },
        "taskingen.tree.defaultExpandedDepth": {
          "type": "integer",
          "order": 21,
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "How many tree levels are expanded by default. 0 collapses everything, 1 expands only the root npm/Deno/shell groups, and higher values expand deeper project and script groups."
        },
        "taskingen.npmProjectGrouping.groupByScope": {
          "type": "boolean",
          "order": 30,
          "default": true,
          "description": "Group scoped npm or Deno packages (for example @cemcakirlar/mst-tab-sync) under a shared @scope node."
        },
        "taskingen.npmProjectGrouping.folderMaxDepth": {
          "type": "integer",
          "order": 31,
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "How many nearest workspace-relative folder levels to show under npm Scripts, Deno Tasks, and Shell Scripts (counting up from each item). Use 0 for a flat list. Does not limit how deeply package.json, Deno, or shell files are discovered."
        },
        "taskingen.npmScriptGrouping.separator": {
          "type": "string",
          "order": 40,
          "default": ":",
          "description": "Literal separator used to nest npm script and Deno task names under project folders. An empty value disables grouping."
        },
        "taskingen.npmScriptGrouping.maxDepth": {
          "type": "integer",
          "order": 41,
          "default": 1,
          "minimum": 0,
          "maximum": 10,
          "description": "Maximum number of separator-based group levels under each npm or Deno project. Use 0 to disable grouping."
        },
        "taskingen.scriptClickAction": {
          "type": "string",
          "order": 50,
          "enum": [
            "open",
            "execute"
          ],
          "default": "open",
          "description": "What happens when you activate a script name in the tree (see Script Click Mode). Inline Open and Run actions remain available either way.",
          "enumDescriptions": [
            "Open the package.json script entry, deno.json task entry, or shell script file in the editor.",
            "Run the script in the terminal."
          ]
        },
        "taskingen.scriptClickMode": {
          "type": "string",
          "order": 51,
          "enum": [
            "singleClick",
            "doubleClick"
          ],
          "default": "doubleClick",
          "description": "Whether the configured script action runs on a single click or a double click. Interacts with workbench.list.openMode: when that setting is doubleClick, Taskingen activates when the tree item opens (typically on double click).",
          "enumDescriptions": [
            "Activate the script when the tree item opens on a single click (or on double click if workbench.list.openMode is doubleClick).",
            "Activate the script on double click."
          ]
        },
        "taskingen.running.enabled": {
          "type": "boolean",
          "order": 59,
          "default": true,
          "description": "Show the Running group at the top of the Taskingen tree with currently active script runs."
        },
        "taskingen.favorites.enabled": {
          "type": "boolean",
          "order": 60,
          "default": true,
          "description": "Show the Favorites group at the top of the Taskingen tree with pinned scripts from the current workspace."
        },
        "taskingen.favorites.maxItems": {
          "type": "integer",
          "order": 61,
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "How many pinned scripts to show under Favorites. Newest pins appear first; older pins stay stored and become visible again when a newer pin is removed or this limit is raised."
        },
        "taskingen.taskHistory.enabled": {
          "type": "boolean",
          "order": 70,
          "default": true,
          "description": "Show the Task History group at the top of the Taskingen tree with recently run scripts from the current workspace folder."
        },
        "taskingen.taskHistory.maxItems": {
          "type": "integer",
          "order": 71,
          "default": 5,
          "minimum": 1,
          "maximum": 50,
          "description": "How many recently run scripts to show under Task History."
        }
      }
    }
  }
}
